{
  "title": "PM Market Strategy Report",
  "description": "Schema for the structured output of the PM & Market Strategist Agent",
  "type": "object",
  "required": [
    "metadata",
    "executive_summary",
    "problem_statement",
    "proposed_solution",
    "market_analysis",
    "competitive_landscape",
    "target_audience",
    "value_proposition",
    "risk_assessment",
    "feasibility_scorecard",
    "gtm_signals",
    "recommendations"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["product_name", "generated_date", "agent_version", "input_source"],
      "properties": {
        "product_name": { "type": "string" },
        "generated_date": { "type": "string", "format": "date" },
        "agent_version": { "type": "string" },
        "input_source": { "type": "string", "description": "Brief description of input type" }
      }
    },
    "executive_summary": {
      "type": "string",
      "minLength": 50,
      "maxLength": 500
    },
    "problem_statement": {
      "type": "string",
      "minLength": 50
    },
    "proposed_solution": {
      "type": "string",
      "minLength": 50
    },
    "market_analysis": {
      "type": "object",
      "required": ["tam", "sam", "som", "trends", "why_now"],
      "properties": {
        "tam": {
          "type": "object",
          "required": ["value", "source_type"],
          "properties": {
            "value": { "type": "string" },
            "source_type": { "type": "string", "enum": ["estimated", "sourced"] },
            "source": { "type": "string" }
          }
        },
        "sam": {
          "type": "object",
          "required": ["value", "source_type"],
          "properties": {
            "value": { "type": "string" },
            "source_type": { "type": "string", "enum": ["estimated", "sourced"] },
            "source": { "type": "string" }
          }
        },
        "som": {
          "type": "object",
          "required": ["value", "source_type"],
          "properties": {
            "value": { "type": "string" },
            "source_type": { "type": "string", "enum": ["estimated", "sourced"] },
            "source": { "type": "string" }
          }
        },
        "trends": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 3
        },
        "why_now": { "type": "string" }
      }
    },
    "competitive_landscape": {
      "type": "object",
      "required": ["direct_competitors", "indirect_competitors", "differentiation"],
      "properties": {
        "direct_competitors": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "required": ["name", "strengths", "weaknesses", "pricing"],
            "properties": {
              "name": { "type": "string" },
              "strengths": { "type": "string" },
              "weaknesses": { "type": "string" },
              "pricing": { "type": "string" }
            }
          }
        },
        "indirect_competitors": {
          "type": "array",
          "items": { "type": "string" }
        },
        "differentiation": { "type": "string" }
      }
    },
    "target_audience": {
      "type": "object",
      "required": ["personas", "jtbd"],
      "properties": {
        "personas": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "role", "company_type", "pain", "goal"],
            "properties": {
              "name": { "type": "string" },
              "role": { "type": "string" },
              "type": { "type": "string", "enum": ["primary", "secondary"] },
              "company_type": { "type": "string" },
              "pain": { "type": "string" },
              "goal": { "type": "string" },
              "behavior": { "type": "string" }
            }
          }
        },
        "jtbd": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 2
        }
      }
    },
    "value_proposition": {
      "type": "object",
      "required": ["customer_pains", "customer_gains", "pain_relievers", "gain_creators"],
      "properties": {
        "customer_pains": { "type": "array", "items": { "type": "string" }, "minItems": 2 },
        "customer_gains": { "type": "array", "items": { "type": "string" }, "minItems": 2 },
        "pain_relievers": { "type": "array", "items": { "type": "string" }, "minItems": 2 },
        "gain_creators": { "type": "array", "items": { "type": "string" }, "minItems": 2 }
      }
    },
    "risk_assessment": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["risk", "category", "severity", "mitigation"],
        "properties": {
          "risk": { "type": "string" },
          "category": { "type": "string", "enum": ["market", "technical", "business"] },
          "severity": { "type": "string", "enum": ["high", "medium", "low"] },
          "mitigation": { "type": "string" }
        }
      }
    },
    "feasibility_scorecard": {
      "type": "object",
      "required": ["viability", "desirability", "feasibility", "overall", "justification"],
      "properties": {
        "viability": { "type": "number", "minimum": 1, "maximum": 10 },
        "desirability": { "type": "number", "minimum": 1, "maximum": 10 },
        "feasibility": { "type": "number", "minimum": 1, "maximum": 10 },
        "overall": { "type": "number", "minimum": 1, "maximum": 10 },
        "justification": {
          "type": "object",
          "required": ["viability", "desirability", "feasibility"],
          "properties": {
            "viability": { "type": "string" },
            "desirability": { "type": "string" },
            "feasibility": { "type": "string" }
          }
        }
      }
    },
    "gtm_signals": {
      "type": "object",
      "required": ["positioning", "pricing_model", "distribution_channels", "traction_strategies"],
      "properties": {
        "positioning": { "type": "string" },
        "pricing_model": { "type": "string" },
        "distribution_channels": { "type": "array", "items": { "type": "string" }, "minItems": 2 },
        "traction_strategies": { "type": "array", "items": { "type": "string" }, "minItems": 2 }
      }
    },
    "recommendations": {
      "type": "object",
      "required": ["verdict", "summary", "assumptions_to_validate", "suggested_experiments", "handoff"],
      "properties": {
        "verdict": { "type": "string", "enum": ["GO", "NO-GO", "PIVOT"] },
        "summary": { "type": "string" },
        "assumptions_to_validate": { "type": "array", "items": { "type": "string" }, "minItems": 2 },
        "suggested_experiments": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "handoff": {
          "type": "object",
          "required": ["architecture", "implementation"],
          "properties": {
            "architecture": { "type": "array", "items": { "type": "string" } },
            "implementation": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    }
  }
}
